# BhashaBridge Environment Variables
# Never commit real API keys to source control.

# Frontend (frontend/.env)
VITE_BACKEND_URL=http://localhost:8080/api

# Python AI engine (ai/.env) — REQUIRED for real AI responses
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_openrouter_model_id_here
OPENROUTER_TIMEOUT=30

# Planned integrations (not used yet)
SARVAM_API_KEY=your_sarvam_api_key_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/bhashabridge
