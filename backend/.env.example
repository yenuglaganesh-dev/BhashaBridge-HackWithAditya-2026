# BhashaBridge Java Backend Environment Variables
# The backend reads src/main/resources/application.properties.
# Override values here or via environment variables when deploying.

# Server
server.port=8080
server.servlet.context-path=/api

# Python AI engine
ai.service.url=http://localhost:8000

# CORS (React dev server origin)
cors.allowed-origins=http://localhost:5173
