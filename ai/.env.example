# BhashaBridge Python FastAPI Environment Variables

# Server Configuration
host=0.0.0.0
port=8000
debug=True

# OpenRouter AI Provider (REQUIRED for real AI responses)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_openrouter_model_id_here
OPENROUTER_TIMEOUT=30

# SARVAM AI (optional - set SARVAM_API_KEY to enable voice features)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saarika-v1
SARVAM_TTS_MODEL=saarika-v1

# RAG / Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Database
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/bhashabridge

# CORS
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development
